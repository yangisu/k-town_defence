# 루트는 항상 integrated backend를 사용한다. UI-only 체험은 /demo에서 연다.
KTOWN_API_BASE_URL=http://127.0.0.1:8000
KTOWN_SESSION_SECRET=
# FastAPI의 KTOWN_GATEWAY_SECRET과 동일한 값. 공개된 백엔드를 호출할 때
# 신뢰할 수 있는 게이트웨이임을 증명하는 값이라 브라우저에 노출되면 안 된다.
KTOWN_GATEWAY_SECRET=

# 공개 키는 반드시 실제 도메인 referrer로 제한한다.
NEXT_PUBLIC_AWS_LOCATION_API_KEY=example-restricted-map-key
NEXT_PUBLIC_AWS_LOCATION_REGION=ap-northeast-1
NEXT_PUBLIC_AWS_LOCATION_STYLE=Standard

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
