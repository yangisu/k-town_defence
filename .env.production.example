# Public hostname. Point its A record to the EC2 Elastic IP before starting Caddy.
SITE_DOMAIN=ktowndefense.site

# PostgreSQL stays inside the Docker network; do not open 5432/3306 publicly.
POSTGRES_DB=ktown
POSTGRES_USER=ktown
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password

# Server-only secrets.
KTOUR_SERVICE_KEY=
KTOWN_SESSION_SECRET=replace-with-at-least-32-random-characters
# Shared between the api and web containers, and with any other trusted
# gateway (e.g. a Vercel deployment) allowed to call the public /api/v1
# route below. Never expose this to a browser.
KTOWN_GATEWAY_SECRET=replace-with-at-least-32-random-characters

# Browser-visible Amazon Location key. Restrict it to the production domain.
NEXT_PUBLIC_AWS_LOCATION_API_KEY=
NEXT_PUBLIC_AWS_LOCATION_REGION=ap-northeast-1
NEXT_PUBLIC_AWS_LOCATION_STYLE=Standard

# Optional social login. Register callbacks as
# https://<SITE_DOMAIN>/api/auth/<provider>/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# integrated (default) gates on season membership and keeps the session on the
# server; demo shows the local artist picker and lets the browser own the
# session, which is what makes "reset demo" able to clear anything.
KTOWN_SERVICE_MODE=integrated
