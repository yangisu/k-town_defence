# Vercel Preview와 Production에 같은 네 개 값을 설정한다.
# 공개 키는 반드시 아래 README의 map actions와 Vercel referrer 제한을 적용한다.
KTOWN_SERVICE_MODE=demo
NEXT_PUBLIC_AWS_LOCATION_API_KEY=example-restricted-map-key
NEXT_PUBLIC_AWS_LOCATION_REGION=ap-northeast-2
NEXT_PUBLIC_AWS_LOCATION_STYLE=Standard

# SNS 로그인. ChatGPT 플랫폼 헤더가 없는 standalone 접속(예: 로컬 npm run start, Vercel)에서
# 로그인 세션 쿠키에 서명하는 데 쓰인다. 최소 16자 임의 문자열.
KTOWN_SESSION_SECRET=
# 각 제공자 개발자 콘솔에서 발급. redirect URI는 {origin}/api/auth/{provider}/callback.
# 하나라도 비어 있으면 해당 제공자의 로그인 버튼은 503을 반환한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
