www.{$SITE_DOMAIN} {
    redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), geolocation=(self)"
        -Server
    }

    handle /healthz {
        rewrite * /health/ready
        reverse_proxy api:8000
    }

    # Public entry point for trusted external gateways (e.g. a Vercel
    # deployment of web/). FastAPI itself rejects any request that does not
    # carry the matching X-KTown-Gateway-Secret header, so this route stays
    # safe to expose even though it bypasses the Next.js server.
    handle /api/v1/* {
        reverse_proxy api:8000
    }

    reverse_proxy web:3000 {
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Proto {scheme}
    }
}
